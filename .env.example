# Local PostgreSQL started by `docker compose up -d postgres`.
DATABASE_URL=postgres://controlplane:controlplane@127.0.0.1:5433/controlplane

# Zoho CRM access token. Keep this only in .env; never commit it.
# Current ConnectorKit v0.7 support uses an access token supplied by the host. Zoho access tokens
# normally expire after one hour, so replace this value when Zoho reports auth_expired.
ZOHO_CRM_TOKEN=

# Data center suffix: com, eu, in, com.au, jp, ca, sa, or com.cn.
ZOHO_CRM_REGION=com

# Zoho module API name and fields to copy. id and Modified_Time are always included.
ZOHO_CRM_MODULE=Contacts
ZOHO_CRM_FIELDS=Last_Name,First_Name,Email,Phone

# Separates checkpoints when several Zoho accounts use this ControlPlane.
ZOHO_CONNECTION_ID=local-account

# Optional override. Default: zoho:<connection id>:<module>.
# SYNCORE_SYNC_NAME=zoho:local-account:Contacts
