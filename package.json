{
  "name": "controlplane",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hostable control plane for reliable agents and automations, built as a modular monolith.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "npm run build && npm run check:boundaries && node --test \"dist/**/*.test.js\"",
    "start": "npm run build && node dist/apps/server/src/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
